{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "bassign",
    "Audience": "bassign",
    "WebSessionHours": 8,
    "RefreshTokenDays": 30
  },
  "Retention": {
    "WhatsAppMessageDays": 90,
    "NotificationDays": 90,
    "ProofPhotoDays": 365,
    "InviteDays": 90,
    "AiUsageDays": 365,
    "AuditDays": 2555
  },
  "WhatsApp": {},
  "Ai": {
    "Provider": "claude",
    "Model": "claude-haiku-5-5",
    "MinConfidence": 0.6,
    "TimeoutSeconds": 15,
    "MaxInputChars": 6000,
    "MaxOutputTokens": 400,
    "SuggestionsEnabled": true,
    "SummariesEnabled": true
  }
}
