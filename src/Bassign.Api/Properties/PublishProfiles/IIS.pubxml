<?xml version="1.0" encoding="utf-8"?>
<!-- Step 17 (decision #17): framework-dependent for IIS + the .NET 10 Hosting Bundle.
     Publish from Visual Studio (Publish → IIS) or: dotnet publish src/Bassign.Api -p:PublishProfile=IIS
     Output goes to artifacts/publish/api; deploy/Build-Release.ps1 builds both apps + the migration bundle. -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishUrl>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\api\</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>
</Project>
