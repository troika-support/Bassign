<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Bassign.Mobile.Components"
             x:Class="Bassign.Mobile.MainPage"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light=#F6F7F9, Dark=#121418}">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Main}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
