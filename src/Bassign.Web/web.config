<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings for Bassign.Web (step 17). The SDK fills in processPath/arguments when publishing.
     Settings and secrets are NOT here: they are app-pool environment variables (deploy/Set-BassignEnvironment.ps1). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- To diagnose a 500.30 start-up failure: set stdoutLogEnabled="true" temporarily, check .\logs, then turn it off. -->
      <aspNetCore processPath="dotnet" arguments=".\Bassign.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 8 MB: above the API's 6 MB proof-photo limit; the app enforces the real limits per endpoint. -->
          <requestLimits maxAllowedContentLength="8388608" />
        </requestFiltering>
      </security>
      <webSocket enabled="true" />
    </system.webServer>
  </location>
</configuration>
