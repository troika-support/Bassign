@using Bassign.Application.Tasks.UpdateTask
@using Bassign.Application.Tasks.Settings
@inject IUiSender Sender
@inject OrgClock Clock

<MudDialog>
    <DialogContent>
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_title" Label="Title" Required="true" Immediate="true" Class="mb-3" />
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_detail" Label="Detail" Lines="3" Class="mb-3" />
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
            <div style="flex:1; min-width:160px;">
                <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="_due" Label="Due date" Editable="true" Clearable="true" />
            </div>
            <div style="flex:1; min-width:140px;">
                <MudTimePicker Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Time="_time" Label="Time (optional)" AmPm="true" Editable="true" Clearable="true"
                               Disabled="@(_due is null)" HelperText="@DueHelp" />
            </div>
        </div>
        @if (_categories.Count > 0)
        {
            <MudSelect T="Guid?" @bind-Value="_categoryId" Label="Category (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mt-3">
                @foreach (var c in _categories)
                {
                    <MudSelectItem T="Guid?" Value="@c.Id">@(c.IsArchived ? $"{c.Name} (archived)" : c.Name)</MudSelectItem>
                }
            </MudSelect>
        }
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TaskDto Task { get; set; } = default!;

    private string _title = "";
    private string? _detail;
    private DateTime? _due;
    private TimeSpan? _time;
    private Guid? _categoryId;
    private TaskDefaultsVm? _defaults;
    private List<TaskCategoryVm> _categories = [];

    private string DueHelp => _defaults is { } d ? $"Blank = end of the working day ({d.DefaultDueTime:hh\\:mm})" : "Blank = end of the working day";
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _title = Task.Title;
        _detail = Task.Detail;
        _categoryId = Task.CategoryId;
        _defaults = await Sender.Send(new GetTaskDefaultsQuery(IncludeArchived: true));
        // Active categories, plus this task's own if it has since been archived.
        _categories = _defaults.Categories.Where(c => !c.IsArchived || c.Id == Task.CategoryId).ToList();
        if (Task.DueDate is { } due)
        {
            var zoned = OrgClock.InZone(due, await Clock.ZoneAsync());
            _due = zoned.Date;
            _time = OrgClock.IsDateOnly(zoned) ? null : zoned.TimeOfDay;
        }
    }

    private async Task Save()
    {
        _busy = true;
        _error = null;
        DateTimeOffset? due = _due is { } d ? OrgClock.FromPicker(d, _time, await Clock.ZoneAsync(), _defaults?.DefaultDueTime) : null;
        var r = await Sender.TrySend(new UpdateTaskCommand(Task.Id, _title, _detail, due, _categoryId));
        if (r.IsSuccess) MudDialog.Close(DialogResult.Ok(true));
        else { _error = r.Error.Message; _busy = false; }
    }
}
