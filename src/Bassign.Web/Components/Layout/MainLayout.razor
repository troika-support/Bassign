@inject TaskListEvents TaskEvents
@inherits LayoutComponentBase
@using Bassign.Application.Organizations.GetOrganization
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject IUiSender Sender

<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<HeadContent>
    <style>@_brandCss</style>
</HeadContent>

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Transparent" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" Class="d-flex d-md-none" aria-label="Toggle navigation" />
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" aria-label="Notifications" />
        <AuthorizeView>
            <MudMenu Icon="@Icons.Material.Outlined.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight">
                <div class="px-4 py-2">
                    <MudText Typo="Typo.body2">@context.User.Identity?.Name</MudText>
                </div>
                <MudDivider />
                <MudButton Href="/profile" FullWidth="true" Class="justify-start"
                           StartIcon="@Icons.Material.Outlined.Person">Profile</MudButton>
                <form method="post" action="/account/logout" data-enhance="false">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" FullWidth="true" Class="justify-start"
                               StartIcon="@Icons.Material.Filled.Logout">Sign out</MudButton>
                </form>
            </MudMenu>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Never" Variant="@DrawerVariant.Responsive">
        <div class="ba-brand">
            <span class="ba-orgmark">@_initial</span>
            <span class="ba-orgname">@_orgName</span>
        </div>
        <AuthorizeView Roles="Admin,Manager">
            <div class="ba-newtask">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="NewTask">New task</MudButton>
            </div>
        </AuthorizeView>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <div class="ba-content">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private MudTheme _theme = BassignTheme.Build();
    private string _orgName = "Bassign";
    private string _initial = "B";
    private string _brandCss = "";

    protected override async Task OnInitializedAsync()
    {
        var org = await Sender.Send(new GetOrganizationQuery());
        _orgName = org.Name;
        _initial = org.Name.Trim() is { Length: > 0 } n ? n[..1].ToUpperInvariant() : "B";
        _theme = BassignTheme.Build(org.AccentHex);
        var accent = Bassign.Domain.Common.ColorContrast.AccessibleOnWhite(org.AccentHex);   // AAA: ≥7:1 with white
        _brandCss = $":root{{--ba-accent:{accent};--ba-accent-600:{BrandColors.Shade(accent, 0.15)};--ba-accent-tint:{BrandColors.Tint(org.AccentHex, 0.90)};}}";
    }

    private async Task NewTask()
    {
        var dialog = await Dialogs.ShowAsync<NewTaskDialog>("New task");
        if ((await dialog.Result)!.Canceled) return;
        await TaskEvents.RaiseAsync();
        if (!Nav.Uri.Contains("/tasks", StringComparison.OrdinalIgnoreCase)) Nav.NavigateTo("/tasks");
    }
}
