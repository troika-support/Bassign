@inherits LayoutComponentBase
@using Bassign.Application.Organizations.GetOrganization
@inject IUiSender Sender

<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudPopoverProvider />

<HeadContent>
    <style>@_brandCss</style>
</HeadContent>

<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; background:var(--ba-bg); padding:16px;">
    @Body
</div>

@code {
    private MudTheme _theme = BassignTheme.Build();
    private string _brandCss = "";

    protected override async Task OnInitializedAsync()
    {
        var org = await Sender.Send(new GetOrganizationQuery());
        _theme = BassignTheme.Build(org.AccentHex);
        var accent = Bassign.Domain.Common.ColorContrast.AccessibleOnWhite(org.AccentHex);   // AAA: ≥7:1 with white
        _brandCss = $":root{{--ba-accent:{accent};--ba-accent-600:{BrandColors.Shade(accent, 0.15)};--ba-accent-tint:{BrandColors.Tint(org.AccentHex, 0.90)};}}";
    }
}
