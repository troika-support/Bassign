@page "/"
@attribute [Authorize]
@using Bassign.Application.Dashboard
@using Bassign.Application.Organizations.GetOrganization
@inject IUiSender Sender

<PageTitle>Workload · Bassign</PageTitle>

@if (_vm is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading" />
}
else
{
    <h1 class="ba-page-title">@_greeting@(_firstName is null ? "" : $", {_firstName}")</h1>
    <p class="ba-page-sub">@DateTime.Now.ToString("dddd d MMM") · @_vm.Metrics.OpenTasks open tasks</p>

    @if (_org is { SetupCompleted: false })
    {
        <AuthorizeView Roles="Admin">
            <div class="ba-card pa-4 mb-5" style="background:var(--ba-accent-tint); border-color:transparent; display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
                <MudIcon Icon="@Icons.Material.Outlined.Flag" Style="color:var(--ba-accent);" />
                <div style="flex:1; min-width:220px;">
                    <b>Finish setting up your workspace</b>
                    <div class="ba-workload__meta">Name your organization, pick your brand colour and invite your team.</div>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/setup">Start setup</MudButton>
            </div>
        </AuthorizeView>
    }

    <AuthorizeView Roles="Admin,Manager">
        <DailySummaryCard />
    </AuthorizeView>

    <MudGrid Spacing="3" Class="mb-6">
        <MetricCard Label="Open tasks" Value="@_vm.Metrics.OpenTasks" Icon="@Icons.Material.Outlined.Assignment"
                    Sub="@($"{_vm.Metrics.InProgress} in progress")" />
        <MetricCard Label="Overdue" Value="@_vm.Metrics.Overdue" Icon="@Icons.Material.Outlined.ErrorOutline"
                    Variant="overdue" Sub="@(_vm.Metrics.Overdue > 0 ? "Needs attention" : "All on track")" SubAlert="@(_vm.Metrics.Overdue > 0)" />
        <MetricCard Label="Due today" Value="@_vm.Metrics.DueToday" Icon="@Icons.Material.Outlined.Today" Variant="duetoday" />
        <MetricCard Label="Unassigned" Value="@_vm.Metrics.Unassigned" Icon="@Icons.Material.Outlined.PersonOutline"
                    Sub="@(_vm.Metrics.Unassigned > 0 ? "Need an owner" : null)" />
        <MetricCard Label="Done this week" Value="@_vm.Metrics.DoneThisWeek" Icon="@Icons.Material.Outlined.CheckCircle" Variant="ontime" />
    </MudGrid>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="5">
            <div class="ba-card pa-4" style="height:100%;">
                <MudText Typo="Typo.subtitle1" Class="mb-1" Style="font-weight:600;">Open work</MudText>
                <MudText Typo="Typo.caption" Class="mb-3" Style="color:var(--ba-muted);">@_vm.Metrics.OpenTasks open tasks</MudText>
                @if (_donutSeries.Count > 0)
                {
                    <div style="display:flex; align-items:center; gap:24px; flex-wrap:wrap;">
                        <MudChart T="double" ChartType="ChartType.Donut" Width="150px" Height="150px"
                                  ChartSeries="_donutSeries" ChartLabels="_donutLabels" ChartOptions="_donutOptions" />
                        <div>
                            @foreach (var s in _vm.StatusMix)
                            {
                                <div style="display:flex; align-items:center; gap:8px; padding:3px 0;">
                                    <span style="width:10px; height:10px; border-radius:3px; background:@ColorFor(s.Label);"></span>
                                    <span style="min-width:90px;">@s.Label</span>
                                    <b class="ba-metric">@s.Count</b>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="ba-empty__hint">No open tasks right now.</p>
                }
            </div>
        </MudItem>

        <MudItem xs="12" md="7">
            <div class="ba-card pa-4" style="height:100%;">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">Team workload</MudText>
                @if (_vm.Workload.Count == 0)
                {
                    <p class="ba-empty__hint">No tasks yet — assign your first one.</p>
                }
                else
                {
                    var max = _vm.Workload.Max(w => w.Active);
                    @foreach (var row in _vm.Workload)
                    {
                        <div class="ba-workload">
                            <span class="ba-avatar">@Initials(row.Name)</span>
                            <span class="ba-workload__name" style="min-width:140px;">@row.Name</span>
                            <div class="ba-bar"><div class="ba-bar__fill" style="width:@(Pct(row.Active, max))%"></div></div>
                            <span class="ba-workload__meta">@row.Active active · @row.Overdue overdue</span>
                        </div>
                    }
                }
            </div>
        </MudItem>
    </MudGrid>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private DashboardVm? _vm;
    private OrganizationVm? _org;
    private string? _firstName;
    private string _greeting = "Hello";
    private List<ChartSeries<double>> _donutSeries = [];
    private string[] _donutLabels = [];
    private readonly DonutChartOptions _donutOptions = new() { ChartPalette = ["#2563EB", "#4F46E5", "#C01B1B"], ShowLegend = false };

    protected override async Task OnInitializedAsync()
    {
        _greeting = DateTime.Now.Hour switch { < 12 => "Good morning", < 18 => "Good afternoon", _ => "Good evening" };
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _firstName = user.Identity?.Name?.Split(' ').FirstOrDefault();
        }

        _org = await Sender.Send(new GetOrganizationQuery());
        _vm = await Sender.Send(new GetDashboardQuery());
        _donutLabels = _vm.StatusMix.Select(s => s.Label).ToArray();
        _donutSeries = _vm.StatusMix.Count == 0 ? []
            : [ new ChartSeries<double> { Name = "Open work", Data = _vm.StatusMix.Select(s => (double)s.Count).ToArray() } ];
    }

    private static string ColorFor(string label) => label switch
    {
        "To do" => "#2563EB", "In progress" => "#4F46E5", "Overdue" => "#C01B1B", _ => "#8A909E"
    };

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : (parts.Length == 1 ? parts[0][..1] : $"{parts[0][0]}{parts[^1][0]}").ToUpperInvariant();
    }

    private static int Pct(int value, int max) => max <= 0 ? 0 : (int)Math.Round(100.0 * value / max);
}
