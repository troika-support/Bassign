@page "/tasks"
@attribute [Authorize]
@using Bassign.Application.Tasks.ListTasks
@using Bassign.Application.Tasks.Settings
@inject IUiSender Sender
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject OrgClock Clock
@inject ISnackbar Snackbar
@inject TaskListEvents TaskEvents
@implements IDisposable

<PageTitle>Tasks · Bassign</PageTitle>

<h1 class="ba-page-title">Tasks</h1>

<div class="ba-toolbar">
    <div class="ba-toolbar__filters" role="group" aria-label="Filter tasks">
        @foreach (var (key, label) in _pills)
        {
            <MudButton Class="ba-pill"
                       Variant="@(_filter == key ? Variant.Filled : Variant.Outlined)"
                       Color="@(_filter == key ? Color.Primary : Color.Default)"
                       aria-pressed="@(_filter == key ? "true" : "false")"
                       OnClick="@(() => _filter = key)">@label</MudButton>
        }
    </div>
    @if (_categories.Count > 0)
    {
        <div class="ba-toolbar__category">
            <MudSelect T="Guid?" @bind-Value="_category" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Dense="true">
                <MudSelectItem T="Guid?" Value="@ListTasksQuery.Uncategorised">No category</MudSelectItem>
                @foreach (var c in _categories)
                {
                    <MudSelectItem T="Guid?" Value="@c.Id">@(c.IsArchived ? $"{c.Name} (archived)" : c.Name)</MudSelectItem>
                }
            </MudSelect>
        </div>
    }
    <div class="ba-toolbar__search">
        <MudTextField @bind-Value="_search" Placeholder="Search tasks" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" DebounceInterval="200" aria-label="Search tasks"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    </div>
</div>

@if (_all is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading" />
}
else
{
    @if (_selected.Count > 0)
    {
        <MudPaper Elevation="0" Class="pa-2 mb-2" Style="border:1px solid var(--ba-line); display:flex; gap:8px; align-items:center;">
            <MudText Typo="Typo.body2">@_selected.Count selected</MudText>
            <MudButton Size="Size.Small" OnClick="BulkAssign">Assign…</MudButton>
            <MudButton Size="Size.Small" OnClick="BulkComplete">Mark done</MudButton>
        </MudPaper>
    }

    var rows = Filtered();
    @if (rows.Count == 0)
    {
        <p class="ba-empty__hint">No tasks match these filters.</p>
    }
    else
    {
        <MudDataGrid T="TaskListItemDto" Items="rows" Hover="true" Dense="true"
                     MultiSelection="true" @bind-SelectedItems="_selected" RowClick="OnRowClick">
            <Columns>
                <SelectColumn T="TaskListItemDto" />
                <TemplateColumn Title="Task">
                    <CellTemplate>
                        <a class="ba-rowlink" href="/tasks/@context.Item.Id" @onclick:stopPropagation="true">@context.Item.Title</a>
                        @if (context.Item.CategoryName is { } cat) { <span class="ba-tag">@cat</span> }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Assignee">
                    <CellTemplate>
                        @if (context.Item.AssigneeName is { } who) { @who }
                        else { <span class="ba-unassigned">Unassigned</span> }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Due">
                    <CellTemplate>@(context.Item.DueDate is { } d ? OrgClock.FormatDue(OrgClock.InZone(d, _zone)) : "—")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Status">
                    <CellTemplate><StatusChip Status="@DisplayStatus(context.Item)" /></CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
}

@code {
    private IReadOnlyList<TaskListItemDto>? _all;
    private HashSet<TaskListItemDto> _selected = [];
    private string _search = "";
    private string _filter = "all";
    private TimeZoneInfo _zone = TimeZoneInfo.Utc;
    private Guid? _category;
    private IReadOnlyList<TaskCategoryVm> _categories = [];

    private readonly (string Key, string Label)[] _pills =
    [
        ("all", "All"), ("todo", "To do"), ("inprogress", "In progress"), ("overdue", "Overdue"), ("done", "Done")
    ];

    protected override async Task OnInitializedAsync()
    {
        _zone = await Clock.ZoneAsync();
        _categories = (await Sender.Send(new GetTaskDefaultsQuery(IncludeArchived: true))).Categories;
        await Load();
        TaskEvents.Changed += OnTasksChanged;
    }

    private Task OnTasksChanged() => InvokeAsync(async () => { await Load(); StateHasChanged(); });

    public void Dispose() => TaskEvents.Changed -= OnTasksChanged;

    private async Task Load()
    {
        _selected = [];
        _all = await Sender.Send(new ListTasksQuery(null, null));
    }

    private List<TaskListItemDto> Filtered()
    {
        var now = DateTimeOffset.UtcNow;
        IEnumerable<TaskListItemDto> q = _all ?? [];
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(t => t.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
                             || (t.CategoryName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
        if (_category is { } category)
            q = q.Where(t => category == ListTasksQuery.Uncategorised ? t.CategoryId is null : t.CategoryId == category);
        q = _filter switch
        {
            "todo" => q.Where(t => t.Status == "Todo"),
            "inprogress" => q.Where(t => t.Status == "Accepted"),
            "overdue" => q.Where(t => (t.Status is "Todo" or "Accepted") && t.DueDate is { } d && d < now),
            "done" => q.Where(t => t.Status == "Done"),
            _ => q
        };
        // 3: open work first (overdue naturally leads, ordered by due date; no due date after dated ones),
        // finished work last, most recent first.
        return q
            .OrderBy(t => t.Status is "Todo" or "Accepted" ? 0 : 1)
            .ThenBy(t => t.Status is "Todo" or "Accepted" ? t.DueDate ?? DateTimeOffset.MaxValue : DateTimeOffset.MaxValue)
            .ThenByDescending(t => t.DueDate ?? DateTimeOffset.MinValue)
            .ThenBy(t => t.Title, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    private static string DisplayStatus(TaskListItemDto t)
    {
        var now = DateTimeOffset.UtcNow;
        if (t.Status is "Todo" or "Accepted" && t.DueDate is { } d && d < now) return "Overdue";
        return t.Status switch { "Accepted" => "InProgress", "Todo" => "To do", _ => t.Status };
    }

    private void OnRowClick(DataGridRowClickEventArgs<TaskListItemDto> e) =>
        Nav.NavigateTo($"/tasks/{e.Item.Id}");

    private async Task BulkAssign()
    {
        var parameters = new DialogParameters<AssignDialog> { { x => x.TaskIds, _selected.Select(t => t.Id).ToList() } };
        var dialog = await Dialogs.ShowAsync<AssignDialog>("Assign tasks", parameters);
        if (!(await dialog.Result)!.Canceled) await Load();
    }

    private async Task BulkComplete()
    {
        var picked = _selected.ToList();
        var failures = new List<string>();
        foreach (var t in picked)
        {
            var result = await Sender.TrySend(new Bassign.Application.Tasks.CompleteTask.CompleteTaskCommand(t.Id, null));
            if (!result.IsSuccess) failures.Add($"{t.Title}: {result.Error.Message}");
        }
        await Load();

        var done = picked.Count - failures.Count;
        if (done > 0) Snackbar.Add($"{done} task{(done == 1 ? "" : "s")} marked done.", Severity.Success);
        if (failures.Count > 0)
            Snackbar.Add($"{failures.Count} couldn't be marked done — {string.Join(" · ", failures.Take(3))}", Severity.Warning,
                o => o.VisibleStateDuration = 10000);
    }
}
