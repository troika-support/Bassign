@page "/profile"
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@using Bassign.Application.Messaging.GetMyWhatsApp
@using Bassign.Application.Messaging.StartLink
@using Bassign.Application.Messaging.Unlink
@inject IUiSender Sender
@inject ISnackbar Snackbar
@inject IWebHostEnvironment Env
@inject OrgClock Clock
@inject IJSRuntime JS

<PageTitle>Profile · Bassign</PageTitle>

<h1 class="ba-page-title">Profile</h1>
<p class="ba-page-sub">Your account and how Bassign reaches you.</p>

<MudGrid Spacing="3">
    <MudItem xs="12" md="5">
        <section class="ba-card pa-5 ba-fill" aria-labelledby="acct-h">
            <h2 class="ba-section-label" id="acct-h">Account</h2>
            <dl class="ba-facts">
                <dt>Name</dt><dd>@_name</dd>
                <dt>Email</dt><dd>@_email</dd>
                <dt>Role</dt><dd>@(_roles.Count == 0 ? "Staff" : string.Join(", ", _roles))</dd>
            </dl>
        </section>
    </MudItem>

    <MudItem xs="12" md="7">
        <section class="ba-card pa-5 ba-fill" aria-labelledby="wa-h">
            <h2 class="ba-section-label" id="wa-h">WhatsApp</h2>

            @if (_status is null)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" aria-label="Loading" />
            }
            else if (!_status.Configured)
            {
                <p class="ba-muted">WhatsApp isn't set up for your organization yet. Ask an admin.</p>
            }
            else if (_status.Linked)
            {
                <p class="ba-wa-linked">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" aria-hidden="true" />
                    Linked to <strong>@_status.MaskedPhone</strong>
                </p>
                <p class="ba-muted">New tasks arrive on WhatsApp. Reply with the buttons to accept, decline or mark done — or send TASKS to see your list.</p>

                @if (_confirmUnlink)
                {
                    <div class="ba-inline-confirm" role="alert">
                        <span>Stop WhatsApp messages to this number?</span>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_busy" OnClick="Unlink">Unlink</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="() => _confirmUnlink = false">Cancel</MudButton>
                    </div>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.LinkOff" OnClick="() => _confirmUnlink = true">Unlink WhatsApp</MudButton>
                }
            }
            else if (_link is not null)
            {
                <div class="ba-linksteps">
                    <div class="ba-linkstep"><span class="ba-linkstep__num" aria-hidden="true">1</span><span>Open WhatsApp on your phone.</span></div>
                    <div class="ba-linkstep"><span class="ba-linkstep__num" aria-hidden="true">2</span><span>Send this message to <strong>@_link.BusinessNumber</strong>:</span></div>
                </div>
                <div class="d-flex flex-wrap align-center gap-2">
                    <div class="ba-linkcode" aria-label="Message to send: @_link.MessageText">@_link.MessageText</div>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyCode">
                        @(_copied ? "Copied" : "Copy")
                    </MudButton>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@_link.DeepLink" Target="_blank"
                               StartIcon="@Icons.Material.Filled.OpenInNew">Open WhatsApp</MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="_busy" StartIcon="@Icons.Material.Outlined.Refresh" OnClick="StartLink">New code</MudButton>
                </div>
                <p class="ba-muted ba-waiting mt-3" role="status" aria-live="polite">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ba-waiting__spin" aria-hidden="true" />
                    Waiting for your message… The code expires at @Time(_link.ExpiresAt).
                </p>
                @if (Env.IsDevelopment())
                {
                    <p class="ba-muted">Developing? Send it from the <a class="ba-link" href="/dev/whatsapp?phone=%2B263771234567">WhatsApp simulator</a>.</p>
                }
            }
            else
            {
                <p class="ba-muted">Get new tasks on WhatsApp and act on them with one tap — no app or data bundle needed for the basics.</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" StartIcon="@Icons.Material.Filled.Link" OnClick="StartLink">Link WhatsApp</MudButton>
            }
        </section>
    </MudItem>
</MudGrid>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _name = "", _email = "";
    private List<string> _roles = [];
    private WhatsAppStatusVm? _status;
    private WhatsAppLinkStarted? _link;
    private bool _busy, _confirmUnlink, _copied;
    private readonly CancellationTokenSource _cts = new();
    private TimeZoneInfo _zone = TimeZoneInfo.Utc;

    private string Time(DateTimeOffset at) =>
        OrgClock.InZone(at, _zone).ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        _zone = await Clock.ZoneAsync();
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _name = user.FindFirstValue("name") ?? user.Identity?.Name ?? "";
            _email = user.FindFirstValue(ClaimTypes.Email) ?? user.Identity?.Name ?? "";
            _roles = user.FindAll(ClaimTypes.Role).Select(c => c.Value).Distinct().ToList();
        }
        _status = await Sender.Send(new GetMyWhatsAppQuery());
    }

    private async Task StartLink()
    {
        _busy = true;
        var result = await Sender.TrySend(new StartWhatsAppLinkCommand());
        _busy = false;
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error.Message, Severity.Error);
            return;
        }
        var first = _link is null;
        _copied = false;
        _link = result.Value;
        if (first) _ = PollUntilLinkedAsync();
    }

    /// <summary>The binding is verified by the API's inbox worker, so poll until it shows up.</summary>
    private async Task PollUntilLinkedAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                var status = await Sender.Send(new GetMyWhatsAppQuery(), _cts.Token);
                if (!status.Linked) continue;
                await InvokeAsync(() =>
                {
                    _status = status;
                    _link = null;
                    Snackbar.Add("WhatsApp linked.", Severity.Success);
                    StateHasChanged();
                });
                return;
            }
        }
        catch (OperationCanceledException) { /* page closed */ }
        catch (Exception ex) when (ex is InvalidOperationException or ObjectDisposedException) { /* circuit gone */ }
    }

    private async Task CopyCode()
    {
        if (_link is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _link.MessageText);
            _copied = true;
        }
        catch (JSException)
        {
            Snackbar.Add("Couldn't copy — select the code and copy it manually.", Severity.Info);
        }
    }

    private async Task Unlink()
    {
        _busy = true;
        var result = await Sender.TrySend(new UnlinkWhatsAppCommand());
        _busy = false;
        _confirmUnlink = false;
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error.Message, Severity.Error);
            return;
        }
        _status = await Sender.Send(new GetMyWhatsAppQuery());
        Snackbar.Add("WhatsApp unlinked.", Severity.Info);
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
