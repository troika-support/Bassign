@page "/tasks/{Id:guid}"
@attribute [Authorize]
@using Bassign.Application.Tasks.GetTaskDetail
@using Bassign.Application.Tasks.CompleteTask
@inject IUiSender Sender
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject OrgClock Clock

<PageTitle>@(_vm?.Task.Title ?? "Task") · Bassign</PageTitle>

<a href="/tasks" class="ba-back">← Tasks</a>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading" />
}
else if (_vm is null)
{
    <div class="ba-card pa-6" style="max-width:520px;">
        <h1 class="ba-page-title">Task not found</h1>
        <p class="ba-page-sub" style="margin:0;">It may have been removed. <a href="/tasks">Back to tasks</a></p>
    </div>
}
else
{
    var t = _vm.Task;
    var open = t.Status is "Todo" or "Accepted";

    <div class="ba-detail-head">
        <div class="ba-detail-head__title">
            <h1 class="ba-page-title" style="margin:0;">@t.Title</h1>
            <StatusChip Status="@DisplayStatus(t)" />
        </div>
        <div class="ba-detail-head__actions">
            @if (open)
            {
                <AuthorizeView Roles="Admin,Manager" Context="auth">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit" OnClick="Edit">Edit</MudButton>
                    @if (t.AssigneeId is null)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="Assign">Assign</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="Assign">Reassign</MudButton>
                    }
                </AuthorizeView>
            }
            @if (t.Status == "Accepted")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="MarkDone">Mark done</MudButton>
            }
        </div>
    </div>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <section class="ba-card pa-5 mb-4" aria-labelledby="desc-h">
                <h2 class="ba-section-label" id="desc-h">Description</h2>
                @if (string.IsNullOrWhiteSpace(t.Detail))
                {
                    <p class="ba-muted" style="margin:0;">No description.</p>
                }
                else
                {
                    <p class="ba-body">@t.Detail</p>
                }

                @if (!string.IsNullOrWhiteSpace(t.ProofPhotoRef))
                {
                    <h2 class="ba-section-label" style="margin-top:20px;">Proof of work</h2>
                    <img src="/proof/@t.ProofPhotoRef" alt="Proof-of-work photo for @t.Title" loading="lazy"
                         style="width:100%; max-width:440px; border-radius:10px; display:block;" />
                }
            </section>

            <section class="ba-card pa-5" aria-labelledby="activity-h">
                <h2 class="ba-section-label" id="activity-h">Activity</h2>
                <ol class="ba-activity">
                    @foreach (var (item, index) in _vm.Activity.OrderByDescending(a => a.At).Select((a, i) => (a, i)))
                    {
                        <li class="ba-activity__item @(index == 0 ? "is-latest" : "")">
                            <span class="ba-activity__dot" aria-hidden="true"></span>
                            <div>
                                <span class="ba-activity__what">@ActionLabel(item.Action)</span>
                                <span class="ba-muted"> by @item.ActorName</span>
                                <div class="ba-activity__when">@FormatInstant(item.At)</div>
                            </div>
                        </li>
                    }
                </ol>
            </section>
        </MudItem>

        <MudItem xs="12" md="4">
            <aside class="ba-card pa-5" aria-label="Task properties">
                <dl class="ba-props">
                    <div>
                        <dt>Assignee</dt>
                        <dd>
                            @if (_vm.AssigneeName is null)
                            {
                                <span class="ba-muted">Unassigned</span>
                            }
                            else
                            {
                                <span class="ba-avatar" style="width:26px; height:26px; font-size:.7rem;">@Initials(_vm.AssigneeName)</span>
                                <span>@_vm.AssigneeName</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>Due</dt>
                        <dd>
                            @if (t.DueDate is { } due)
                            {
                                var zoned = OrgClock.InZone(due, _zone);
                                var (relative, overdue) = OrgClock.Relative(zoned, _zone);
                                <span>@OrgClock.FormatDue(zoned)</span>
                                @if (open)
                                {
                                    <span class="ba-pill @(overdue ? "ba-pill--off" : "")">@relative</span>
                                }
                            }
                            else
                            {
                                <span class="ba-muted">No due date</span>
                            }
                        </dd>
                    </div>
                    @if (t.CompletedAt is { } done)
                    {
                        <div><dt>Completed</dt><dd>@FormatInstant(done)</dd></div>
                    }
                    <div>
                        <dt>Category</dt>
                        <dd>@(t.CategoryName ?? "None")</dd>
                    </div>
                    @if (t.Status == "Declined")
                    {
                        <div>
                            <dt>Declined because</dt>
                            <dd>@(t.DeclineReason ?? "No reason given")</dd>
                        </div>
                    }
                    <div>
                        <dt>Proof photo</dt>
                        <dd>@(t.RequiresProofPhoto ? "Required to finish" : "Not required")</dd>
                    </div>
                    <div>
                        <dt>Created</dt>
                        <dd>@FormatInstant(t.CreatedAt)<br /><span class="ba-muted">by @_vm.CreatedByName</span></dd>
                    </div>
                </dl>
            </aside>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private TaskDetailVm? _vm;
    private bool _loading = true;
    private TimeZoneInfo _zone = TimeZoneInfo.Utc;

    protected override async Task OnInitializedAsync()
    {
        _zone = await Clock.ZoneAsync();
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        var result = await Sender.Send(new GetTaskDetailQuery(Id));
        _vm = result.IsSuccess ? result.Value : null;
        _loading = false;
    }

    private async Task MarkDone()
    {
        var r = await Sender.TrySend(new CompleteTaskCommand(Id, null));
        if (!r.IsSuccess) Snackbar.Add(r.Error.Message, Severity.Warning);
        await Load();
    }

    private async Task Assign()
    {
        var parameters = new DialogParameters<AssignDialog> { { x => x.TaskIds, new List<Guid> { Id } } };
        var dialog = await Dialogs.ShowAsync<AssignDialog>(_vm!.Task.AssigneeId is null ? "Assign task" : "Reassign task", parameters);
        if (!(await dialog.Result)!.Canceled) await Load();
    }

    private async Task Edit()
    {
        var parameters = new DialogParameters<EditTaskDialog> { { x => x.Task, _vm!.Task } };
        var dialog = await Dialogs.ShowAsync<EditTaskDialog>("Edit task", parameters);
        if (!(await dialog.Result)!.Canceled) await Load();
    }

    private string FormatInstant(DateTimeOffset value) => OrgClock.InZone(value, _zone).ToString("ddd d MMM, h:mm tt");

    private static string DisplayStatus(TaskDto t)
    {
        if (t.Status is "Todo" or "Accepted" && t.DueDate is { } d && d < DateTimeOffset.UtcNow) return "Overdue";
        return t.Status switch { "Accepted" => "InProgress", "Todo" => "To do", _ => t.Status };
    }

    private static string ActionLabel(string action) => action switch
    {
        "task.create" => "Created",
        "task.assign" => "Assigned",
        "task.accept" => "Accepted",
        "task.complete" => "Marked done",
        "task.decline" => "Declined",
        "task.update" => "Edited",
        _ => action
    };

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : (parts.Length == 1 ? parts[0][..1] : $"{parts[0][0]}{parts[^1][0]}").ToUpperInvariant();
    }
}
