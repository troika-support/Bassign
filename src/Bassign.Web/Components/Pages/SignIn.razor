@page "/sign-in"
@layout Bassign.Web.Components.Layout.AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Sign in · Bassign</PageTitle>

<MudPaper Elevation="0" Class="pa-8" Style="width:100%; max-width:380px; border:1px solid var(--ba-line); border-radius:12px;">
    <div style="text-align:center; margin-bottom:24px;">
        <img src="logo.svg" alt="Bassign" height="28" />
        <h1 style="font-size:1.25rem; font-weight:500; margin:16px 0 0;">Sign in to Bassign</h1>
    </div>

    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">That email or password doesn't match.</MudAlert>
    }

    <form method="post" action="/account/login" data-enhance="false">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />

        <label for="email" style="display:block; font-size:.85rem; color:var(--ba-secondary); margin-bottom:4px;">Email</label>
        <input id="email" name="email" type="email" required autocomplete="username"
               style="width:100%; box-sizing:border-box; min-height:44px; padding:0 12px; margin-bottom:16px;
                      border:1px solid var(--ba-line); border-radius:8px; font-size:1rem;" />

        <label for="password" style="display:block; font-size:.85rem; color:var(--ba-secondary); margin-bottom:4px;">Password</label>
        <input id="password" name="password" type="password" required autocomplete="current-password"
               style="width:100%; box-sizing:border-box; min-height:44px; padding:0 12px; margin-bottom:24px;
                      border:1px solid var(--ba-line); border-radius:8px; font-size:1rem;" />

        <button type="submit"
                style="width:100%; min-height:48px; border:none; border-radius:8px; background:var(--ba-accent);
                       color:#fff; font-size:1rem; font-weight:500; cursor:pointer;">Continue</button>
    </form>
</MudPaper>

@code {
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
}
