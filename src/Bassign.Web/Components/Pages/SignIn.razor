@page "/sign-in"
@layout Bassign.Web.Components.Layout.AuthLayout
@attribute [AllowAnonymous]
@using Bassign.Application.Organizations.GetOrganization
@using Bassign.Application.FirstRun
@inject IUiSender Sender
@inject NavigationManager Nav

<PageTitle>Sign in · @_orgName</PageTitle>

<div class="ba-auth">
    <div class="ba-card ba-auth__card">
        <div class="ba-auth__brand">
            <span class="ba-orgmark ba-orgmark--lg" aria-hidden="true">@_initial</span>
            <h1 class="ba-auth__title">Sign in to @_orgName</h1>
            <p class="ba-auth__sub">Welcome back — use your work email.</p>
        </div>

        @if (Error is not null)
        {
            <p class="ba-auth__error" role="alert">That email or password doesn't match. After 5 wrong tries, sign-in pauses for 5 minutes.</p>
        }
        else if (Passkey == "failed")
        {
            <p class="ba-auth__error" role="alert">That passkey didn't work here. Try again, or sign in with your password.</p>
        }
        else if (Expired == 1)
        {
            <p class="ba-auth__error" role="alert">That took a little too long — please sign in again.</p>
        }

        <form method="post" action="/account/login" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <label class="ba-label" for="email">Email</label>
            <input class="ba-input" id="email" name="email" type="email" required autocomplete="username"
                   autofocus inputmode="email" />

            <label class="ba-label" for="password">Password</label>
            <div class="ba-password">
                <input class="ba-input" id="password" name="password" type="@(_showPassword ? "text" : "password")"
                       required autocomplete="current-password" />
                <button type="button" class="ba-password__toggle" @onclick="() => _showPassword = !_showPassword"
                        aria-label="@(_showPassword ? "Hide password" : "Show password")" aria-pressed="@(_showPassword ? "true" : "false")">
                    @(_showPassword ? "Hide" : "Show")
                </button>
            </div>

            <button class="ba-submit" type="submit">Sign in</button>
        </form>

        <div class="ba-or" role="separator" aria-label="or"><span>or</span></div>
        <form method="post" action="/account/passkey/sign-in" data-enhance="false" data-passkey-form="signin">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <input type="hidden" name="credentialJson" />
            <button class="ba-submit ba-submit--secondary" type="button" data-passkey-start>Sign in with a passkey</button>
            <p class="ba-auth__error" role="alert" data-passkey-error hidden style="margin-top:12px;"></p>
        </form>
        <p class="ba-muted" style="margin:16px 0 0; text-align:center; font-size:.8rem;"><a class="ba-link" href="/privacy">Privacy notice</a></p>
    </div>

    <p class="ba-auth__powered">Powered by <span>Bassign</span></p>
</div>

@code {
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private int? Expired { get; set; }
    [SupplyParameterFromQuery] private string? Passkey { get; set; }

    private string _orgName = "Bassign";
    private string _initial = "B";
    private bool _showPassword;

    protected override async Task OnInitializedAsync()
    {
        // A fresh install has nobody to sign in as: go to first-Admin setup instead.
        if (!(await Sender.Send(new GetFirstRunStateQuery())).AdminExists)
        {
            Nav.NavigateTo("/first-admin", replace: true);
            return;
        }
        var org = await Sender.Send(new GetOrganizationQuery());
        _orgName = org.Name;
        _initial = org.Name.Trim() is { Length: > 0 } n ? n[..1].ToUpperInvariant() : "B";
    }
}
